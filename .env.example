# ==============================================================================
# EduNavika — Environment Configuration Template (.env.example)
#
# Copy this file to .env and customize values for your local environment:
#   copy .env.example .env
#
# DO NOT COMMIT REAL CREDENTIALS, PRODUCTION SECRETS, OR PASSWORDS TO GIT.
# ==============================================================================

# Application Environment
# Options: development, testing, production
ENV=development

# Database Connection URL
# Local SQLite default: sqlite:///./edunavika.db
# PostgreSQL example: postgresql://edunavika_user:password@localhost:5432/edunavika
DATABASE_URL=sqlite:///./edunavika.db

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=edunavika-insecure-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Cross-Origin Resource Sharing (CORS)
# Comma-separated or JSON list of allowed frontend origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# On-Device Small Language Model (SLM) Inference (Optional)
# Filesystem path to local GGUF model weights (e.g., Qwen 2.5 0.5B Instruct)
# Leave empty to use deterministic pedagogic explanation fallback
EDUNAVIKA_LOCAL_MODEL_PATH=

# Local SLM Execution Parameters
LOCAL_LLM_N_THREADS=4
LOCAL_LLM_N_CTX=2048
